["johar lagche", "\u09ae\u09c7\u099f\u09cd\u09b0\u09cb\u09b0\u09c7\u09b2 \u0995\u09b0\u09cd\u09a4\u09c3\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u0989\u099a\u09bf\u09a4 \u098f\u0987 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u098f\u0987 \u09ac\u09bf\u099c\u09cd\u099e\u09be\u09aa\u09a8\u09c7\u09b0 \u09ac\u09bf\u09b0\u09c1\u09a6\u09cd\u09a7\u09c7 \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u0995\u09b0\u09be", "\u09a4\u09be\u0987 \u0997\u09be\u0987\u099c", "Redwan", "\u0986\u09ae\u09bf \u0995\u09cb\u0995\u09be\u0995\u09cb\u09b2\u09be \u09b8\u09c7\u09ad\u09c7\u09a8 \u0986\u09aa \u0986\u09b0 \u09b8\u09cd\u09aa\u09cd\u09b0\u09be\u0987\u099f \u099b\u09be\u09dc\u09be \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09aa\u09be\u09a8\u09c0\u09df \u0995\u09bf\u09a8\u09bf \u09a8\u09be\u0964\u2764", "\u09af\u09be\u09b0\u09be \u0987\u09b8\u09b0\u09be\u0987\u09b2 \u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09af\u09bc\u09c7 \u098f\u09a1\u09cd\u09b0\u09c7\u09b8 \u0995\u09b0\u09a4\u09c7\u099b\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09ac\u09af\u09bc\u0995\u099f \u0995\u09b0\u09c1\u09a8 \u09aa\u09a3\u09cd\u09af \u0995\u09c7 \u09a4\u09cb \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0995\u09b0\u09ac\u09c7\u09a8\u0964\u0964", "\u09ae\u09c7\u099f\u09cd\u09b0\u09cb\u09b0\u09c7\u09b2 \u098f \u09af\u09c7 \u0995\u09cb\u09a8 \u0996\u09be\u09a6\u09cd\u09af /\u09aa\u09be\u09a8\u09c0\u09df \u0997\u09cd\u09b0\u09b9\u09a3 \u09a8\u09bf\u09b7\u09bf\u09a6\u09cd\u09a7\u0964", "\ud83d\ude02\ud83d\ude02\ud83d\ude02"]